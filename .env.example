APP_NAME=Alternova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alternova
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Production: set SESSION_SECURE_COOKIE=true when serving over HTTPS
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Optional Redis (only if you have Redis running)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis

SCOUT_DRIVER=collection
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# Prefer Admin → Integrations for GitHub token (no need to put secrets here)
GITHUB_TOKEN=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Production security checklist ----
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=error
