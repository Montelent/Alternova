APP_NAME=Alternova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alternova
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Leave SESSION_SECURE_COOKIE empty — Laravel sets Secure only when the request is HTTPS
# SESSION_SECURE_COOKIE=

SCOUT_DRIVER=collection
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Prefer Admin → Integrations (not required in .env)
GITHUB_TOKEN=

# Optional Redis (only if available)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis

# ---- Production (installer sets these automatically) ----
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=error
